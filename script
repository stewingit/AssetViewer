local function formatTime(seconds)
    local mins = math.floor(seconds / 60)
    local secs = math.floor(seconds % 60)
    return string.format("%02d:%02d", mins, secs)
end

-- Timer Loop Logic
task.spawn(function()
    while task.wait(0.1) do
        if AudioFrame.Visible then
            local activePlayer = (currentAssetInfo and currentAssetInfo.AssetType == 62) and VideoPreview or AudioPlayer
            local current = activePlayer.TimePosition or 0
            local total = activePlayer.TimeLength or 0
            
            if total == 0 then
                TimeLabel.Text = "Loading..."
            else
                TimeLabel.Text = formatTime(current) .. " / " .. formatTime(total)
            end
        end
    end
end)

