WorkspaceActionBtn.MouseButton1Click:Connect(function()
    if not currentAssetInfo then return end
    local assetType = currentAssetInfo.AssetType
    local player = Players.LocalPlayer
    local char = player.Character or player.CharacterAdded:Wait()
    local hrp = char:WaitForChild("HumanoidRootPart")
    local spawnCFrame = hrp.CFrame * CFrame.new(0, 0, -5)

    if assetType == 24 then -- Animation Preview
        if getgenv().CurrentPreviewTrack then
            getgenv().CurrentPreviewTrack:Stop()
            getgenv().CurrentPreviewTrack = nil
            WorkspaceActionBtn.Text = "Play Animation"
        else
            local anim = Instance.new("Animation")
            anim.AnimationId = "rbxassetid://" .. currentAssetId
            local humanoid = char:FindFirstChild("Humanoid")
            if humanoid then
                local animator = humanoid:FindFirstChild("Animator") or Instance.new("Animator", humanoid)
                local track = animator:LoadAnimation(anim)
                track:Play()
                getgenv().CurrentPreviewTrack = track
                WorkspaceActionBtn.Text = "Stop Animation"
            end
        end
    elseif assetType == 2 or assetType == 11 or assetType == 12 then -- Spawn Clothing on Grey Avatar
        local desc = Instance.new("HumanoidDescription")
        if assetType == 2 then desc.GraphicTShirt = tonumber(currentAssetId)
        elseif assetType == 11 then desc.Shirt = tonumber(currentAssetId)
        elseif assetType == 12 then desc.Pants = tonumber(currentAssetId)
        end
        
        local success, dummy = pcall(function()
            return Players:CreateHumanoidModelFromDescription(desc, Enum.HumanoidRigType.R15)
        end)
        
        if success and dummy then
            -- Make dummy grey
            for _, part in ipairs(dummy:GetDescendants()) do
                if part:IsA("BasePart") then
                    part.Color = Color3.fromRGB(163, 162, 165)
                end
            end
            dummy:SetPrimaryPartCFrame(spawnCFrame * CFrame.Angles(0, math.pi, 0))
            dummy.Parent = workspace
            table.insert(spawnedObjects, dummy)
            WorkspaceActionBtn.Text = "Spawned Dummy!"
            game.Debris:AddItem(dummy, 15)
        else
            WorkspaceActionBtn.Text = "Failed to load"
        end
        task.wait(1.5)
        WorkspaceActionBtn.Text = "Spawn Avatar Preview"
        
    elseif assetType == 1 then -- Spawn Part with Decal (Image type only)
        local part = Instance.new("Part")
        part.Size = Vector3.new(4, 4, 1)
        part.CFrame = spawnCFrame
        part.Anchored = true
        part.CanCollide = false
        part.Parent = workspace
        local decal = Instance.new("Decal")
        decal.Face = Enum.NormalId.Front
        decal.Texture = "rbxassetid://" .. currentAssetId
        decal.Parent = part
        table.insert(spawnedObjects, part)
        game.Debris:AddItem(part, 15)
        WorkspaceActionBtn.Text = "Spawned!"
        task.wait(1)
        WorkspaceActionBtn.Text = "Spawn Preview Part"
    elseif assetType == 10 or assetType == 4 or assetType == 8 or assetType == 19 or assetType == 40 or assetType == 61 then -- Spawn Model
        local success, objects = pcall(function() return game:GetObjects("rbxassetid://" .. currentAssetId) end)
        if success and objects then
            for _, obj in ipairs(objects) do
                if obj:IsA("Model") then obj:MoveTo(spawnCFrame.Position)
                elseif obj:IsA("BasePart") or obj:IsA("Accoutrement") then
                    if obj:IsA("BasePart") then obj.CFrame = spawnCFrame end
                end
                obj.Parent = workspace
                table.insert(spawnedObjects, obj)
            end
            WorkspaceActionBtn.Text = "Spawned!"
        else
            WorkspaceActionBtn.Text = "Failed/Restricted"
        end
        task.wait(1.5)
        WorkspaceActionBtn.Text = "Spawn Model"
    end
end)

SaveBtn.MouseButton1Click:Connect(function()
    if currentAssetId == "" or not currentAssetInfo then return end
    
    local oldText = SaveBtn.Text
    local oldColor = SaveBtn.BackgroundColor3
    
    if not writefile then 
        SaveBtn.Text = "No writefile Support"
        return 
    end

    SaveBtn.Text = "Downloading..."
    SaveBtn.BackgroundColor3 = Color3.fromRGB(0, 120, 215)

    task.spawn(function()
        pcall(function()
            if isfolder and not isfolder("AssetViewer") then makefolder("AssetViewer") end
        end)

        local assetType = currentAssetInfo.AssetType
        local ext = ExtensionMap[assetType] or ExtensionMap["Default"]
        local safeName = currentAssetInfo.Name:gsub("[^%w%s]", "")
        local rawData = nil
        local reqFunc = (syn and syn.request) or (http and http.request) or http_request or request

        -- Step 1: Attempt raw download ONLY if it's not an Image (Type 1)
        if assetType ~= 1 then
            local url = "https://assetdelivery.roblox.com/v1/asset/?id=" .. currentAssetId
            if reqFunc then
                local success, response = pcall(function()
                    return reqFunc({
                        Url = url,
                        Method = "GET",
                        Headers = { ["User-Agent"] = "Roblox/WinInet" }
                    })
                end)
                if success and response.Success and #response.Body > 500 then
                    rawData = response.Body
                end
            end

            if not rawData then
                pcall(function() 
                    local res = game:HttpGet(url)
                    if res and #res > 500 then rawData = res end
                end)
            end
        end

        -- Step 2: Handle Saving
        if rawData then
            -- This handles Models/Audio/etc that successfully downloaded raw
            local fileName = string.format("AssetViewer/%s_%s%s", safeName, currentAssetId, ext)
            local writeSuccess = pcall(function() writefile(fileName, rawData) end)
            if writeSuccess then
                SaveBtn.Text = "Saved to files!"
                SaveBtn.BackgroundColor3 = Color3.fromRGB(100, 200, 100)
            else
                SaveBtn.Text = "Write Permission Error"
                SaveBtn.BackgroundColor3 = Color3.fromRGB(255, 100, 100)
            end
        else
            -- Step 3: Fallback logic (Used for Images OR Denied Raw Assets)
            -- If it was a model/audio that failed, show "Denied" first
            if assetType ~= 1 then
                SaveBtn.Text = "Denied"
                SaveBtn.BackgroundColor3 = Color3.fromRGB(255, 100, 100)
                task.wait(1)
            end
            
            -- Show the specific image download text/color from your script
            SaveBtn.Text = "Downloading image..."
            SaveBtn.BackgroundColor3 = Color3.fromRGB(0, 120, 215)
        
            local thumbData = nil
            pcall(function()
                local thumbApiUrl = "https://thumbnails.roblox.com/v1/assets?assetIds=" .. currentAssetId .. "&returnPolicy=PlaceHolder&size=420x420&format=Png&isCircular=false"
                local apiResponse = nil
                
                if reqFunc then
                    local res = reqFunc({Url = thumbApiUrl, Method = "GET"})
                    if res and res.Success then apiResponse = res.Body end
                end
                
                if not apiResponse then apiResponse = game:HttpGet(thumbApiUrl) end
                
                if apiResponse then
                    local decoded = HttpService:JSONDecode(apiResponse)
                    if decoded and decoded.data and decoded.data[1] and decoded.data[1].imageUrl then
                        local imgUrl = decoded.data[1].imageUrl
                        if reqFunc then
                            local imgRes = reqFunc({Url = imgUrl, Method = "GET"})
                            if imgRes and imgRes.Success then thumbData = imgRes.Body end
                        end
                        if not thumbData then thumbData = game:HttpGet(imgUrl) end
                    end
                end
            end)
            
            if thumbData and #thumbData > 100 then
                local thumbFileName = string.format("AssetViewer/%s_%s.png", safeName, currentAssetId)
                local writeSuccess = pcall(function() writefile(thumbFileName, thumbData) end)
                if writeSuccess then
                    task.wait(1) -- Keeping your original timing
                    SaveBtn.Text = "Saved to files!"
                    SaveBtn.BackgroundColor3 = Color3.fromRGB(100, 200, 100)
                else
