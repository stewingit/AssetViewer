AssetSearchBtn.MouseButton1Click:Connect(function()
    local query = IdInput.Text
    if query == "" then return end
    
    AudioPlayer:Stop()
    VideoPreview.Playing = false
    VideoPreview.TimePosition = 0
    PlayBtn.Text = "Play" 
    VideoPreview.Visible = false
    AudioFrame.Visible = false
    AssetPreview.Visible = true -- Default to visible
    
    StatusLabel.Text = "Searching..."
    LoadingIcon.Visible = true
    AssetPreview.ImageTransparency = 1
    AssetPreview.BackgroundTransparency = 1
    
    task.spawn(function()
        local data = getgenv().search(query)
        StatusLabel.Text = data.Status
        
        if data.Success then
            currentAssetId = tostring(data.Info.Id)
            currentAssetInfo = data.Info
            
            local thumbUrl = "rbxthumb://type=Asset&id=" .. currentAssetId .. "&w=420&h=420"
            AssetPreview.Image = thumbUrl
            
            pcall(function() ContentProvider:PreloadAsync({AssetPreview}) end)
            
            AssetPreview.ImageTransparency = 0
            AssetPreview.BackgroundTransparency = 0 
            
            if data.Info.AssetType == 3 then -- Audio
                AudioPlayer.SoundId = "rbxassetid://" .. currentAssetId
                AudioFrame.Visible = true
                VideoPreview.Visible = false
            elseif data.Info.AssetType == 62 then -- Video
                VideoPreview.Video = "rbxassetid://" .. currentAssetId
                VideoPreview.Visible = true
                AudioFrame.Visible = true
                AssetPreview.Visible = false -- Hides the thumbnail image so it doesn't overlap behind the video
                -- Detect Video Dimensions for correct shape
                task.spawn(function()
                    repeat task.wait() until VideoPreview.Resolution ~= Vector2.new(0,0)
                    VideoAspect.AspectRatio = VideoPreview.Resolution.X / VideoPreview.Resolution.Y
                end)
            end
        else
            AssetPreview.Image = "rbxassetid://0"
            AssetPreview.BackgroundTransparency = 0
            AssetPreview.ImageTransparency = 0
            AudioFrame.Visible = false
        end
        LoadingIcon.Visible = false
    end)
end)

local function toggleMedia()
    if currentAssetInfo then
        if currentAssetInfo.AssetType == 62 then
            if VideoPreview.Playing then 
                VideoPreview.Playing = false 
                PlayBtn.Text = "Play"
            else 
                VideoPreview.Playing = true 
                PlayBtn.Text = "Pause"
            end
        elseif currentAssetInfo.AssetType == 3 then
            if AudioPlayer.IsPlaying then 
                AudioPlayer:Pause() 
                PlayBtn.Text = "Play"
            else 
                if AudioPlayer.IsPaused then
                    AudioPlayer:Resume()
                else
                    AudioPlayer:Play()
                end
                PlayBtn.Text = "Pause"
            end
        end
    end
end

PlayBtn.MouseButton1Click:Connect(toggleMedia)

