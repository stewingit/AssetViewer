local function toggleMedia()
    if currentAssetInfo then
        if currentAssetInfo.AssetType == 62 then
            if VideoPreview.Playing then 
                VideoPreview.Playing = false 
                PlayBtn.Text = "Play"
            else 
                VideoPreview.Playing = true 
                PlayBtn.Text = "Pause"
            end
        elseif currentAssetInfo.AssetType == 3 then
            if AudioPlayer.Playing then 
                AudioPlayer:Pause() 
                PlayBtn.Text = "Play"
            else 
                -- FIX: Use Resume() so it doesn't restart from the beginning
                AudioPlayer:Resume() 
                PlayBtn.Text = "Pause"
            end
        end
    end
end

