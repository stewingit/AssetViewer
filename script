SaveBtn.MouseButton1Click:Connect(function()
    if currentAssetId ~= "" and currentAssetInfo then
        if writefile then
            if isfolder and not isfolder("AssetViewer") then makefolder("AssetViewer") end
            local oldText = SaveBtn.Text
            SaveBtn.Text = "Downloading..."
            SaveBtn.BackgroundColor3 = Color3.fromRGB(0, 120, 215)

            task.spawn(function()
                local ext = ExtensionMap[currentAssetInfo.AssetType] or ExtensionMap["Default"]
                local safeName = currentAssetInfo.Name:gsub("[^%w%s]", "")
                local fileName = string.format("AssetViewer/%s_%s%s", safeName, currentAssetId, ext)

                local success, rawData = pcall(function()
                    return game:HttpGet("https://assetdelivery.roblox.com/v1/asset/?id=" .. currentAssetId)
                end)

                if success and rawData then
                    local writeSuccess, err = pcall(function() writefile(fileName, rawData) end)
                    if writeSuccess then
                        SaveBtn.Text = "Saved " .. ext:upper() .. "!"
                        SaveBtn.BackgroundColor3 = Color3.fromRGB(100, 200, 100)
                    else
                        SaveBtn.Text = "Write Error"
                        SaveBtn.BackgroundColor3 = Color3.fromRGB(255, 100, 100)
                    end
                else
                    SaveBtn.Text = "Download Failed"
                    SaveBtn.BackgroundColor3 = Color3.fromRGB(255, 100, 100)
                end
                task.wait(2)
                SaveBtn.Text = oldText
                SaveBtn.BackgroundColor3 = Color3.fromRGB(45, 45, 45)
            end)
        else
            SaveBtn.Text = "writefile not supported"
        end
    end
end)

