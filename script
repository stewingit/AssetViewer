-- Global Search Logic
getgenv().search = function(query)
    local assetId = tonumber(query)
    local results = { Success = false, Info = nil, Status = "Error | Invalid ID" }
    
    if assetId then
        local s, info = pcall(function() return MarketplaceService:GetProductInfo(assetId) end)
        if s and info then
            local typeName = AssetTypes[info.AssetTypeId] or ("Type ID: " .. info.AssetTypeId)
            results.Success = true
            results.Info = {
                Id = assetId,
                Name = info.Name,
                AssetType = info.AssetTypeId,
                TypeName = typeName,
                Creator = info.Creator.Name
            }
            results.Status = string.format("Found %s | %s", typeName, info.Name)
        else
            results.Status = "Roblox Error | ID Not Found or Private"
        end
    end
    getgenv().LastSearch = results
    return results
end

